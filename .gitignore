# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Data and outputs: never committed ---------------------------------------
# Raw datasets live in /data on your machine only. Only its README is tracked.
/data/*
!/data/README.md
output/
outputs/

# --- Node / frontend -------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/

# --- Editors and OS ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.log
