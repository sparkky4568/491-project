# Review console settings. Vite reads env files from the repo root (vite.config.ts sets envDir: '..'),
# so copy this line into ../.env (the repo-root .env), not frontend/.env, then restart `npm run dev`.
#
# VITE_API_URL: base URL of the live scorer API (aven-scorer/src/aven_scorer/api.py), started with
#   aven-scorer serve --port 8787                 (fake backend, free, results marked is_mock)
#   aven-scorer serve --sessions-dir <folder>     (also lists stored ScoredSession files in Runs)
# (aven-scorer-serve and python -m aven_scorer.api start the same server.)
# The API's CORS list allows http://localhost:5173 and http://127.0.0.1:5173 by default.
# Leave it empty for Demo mode: practice scores from keyword rules in the browser, clearly labelled.
# Anything starting with VITE_ is bundled into the browser, so never put a secret in it.
VITE_API_URL=http://127.0.0.1:8787
