# Copy this file to .env at the repo root and fill in values locally.
# Names only here. Never commit .env or real values.

# Review console (frontend). Leave empty to read the mock files in shared/sample_data/.
# Set to the Python API's base URL to read real pipeline output, e.g. http://localhost:8000
# Anything starting with VITE_ is bundled into the browser, so never put a secret in a VITE_ variable.
VITE_API_URL=

# Scorer (AI). LLM provider credentials, server-side only.
LLM_API_KEY=
# Exact pinned model id; it is written into every scored session.
LLM_MODEL_ID=
